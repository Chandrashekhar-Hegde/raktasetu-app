PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local/CI disposable DB only — never point TEST_DATABASE_URL at production Neon.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/raktasetu_test
# FIXTURE_PASSWORD=test-fixture-pass-12
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=30m
# Comma-separated browser origins for CORS / Socket.io when frontend is NOT same-origin.
# Unified Railway deploy is same-origin — localhost Vite is the usual extra origin.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3001
# At domain cutover, include both hosts during transition, e.g.:
# FRONTEND_ORIGINS=https://raktasetu.in,https://raktasetu-production.up.railway.app,http://localhost:5173
# Optional: 301 non-API traffic to the custom domain (off by default). See docs/ops/domain-cutover.md
# CANONICAL_ORIGIN=https://raktasetu.in
# Set to false to disable serving frontend/dist from Express
# SERVE_FRONTEND=true

# Google Sign-In (optional — omit to hide Google button / return 503 on /api/auth/google)
GOOGLE_CLIENT_ID=

# Web Push VAPID (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@raktasetu.org

# Transactional email (password reset + email verification) via Resend's HTTP API.
# Unset: nothing is sent; in development the message (with its link) is printed to the console.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "RaktaSetu <no-reply@raktasetu.in>".
# RESEND_API_KEY=
# EMAIL_FROM=
# Origin used in emailed links. Defaults: CANONICAL_ORIGIN, then https://$RAILWAY_PUBLIC_DOMAIN.
# Never derived from the request Host header (that would allow reset-link poisoning).
# PUBLIC_APP_ORIGIN=https://raktasetu.in

# --- Runtime/database tuning (defaults are fine) ---
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=10000
# Postgres role the API switches to so row-level security applies (default raktasetu_rls in production).
# Production refuses to run if this role can bypass RLS.
# DB_RUNTIME_ROLE=raktasetu_rls
# RAILWAY_ENVIRONMENT is set by Railway; its presence alone switches the app to production mode.

# --- Separate services only (never on the API service) ---
# MIGRATION_DATABASE_URL  GitHub Actions secret: owner URL for migrations (API refuses to boot with it)
# RETENTION_DATABASE_URL  raktasetu-retention cron service
# ESCALATION_DATABASE_URL raktasetu-escalation cron service (falls back to RETENTION_DATABASE_URL)
# INITIAL_ADMIN_EMAIL / ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME / ADMIN_PHONE  scripts/bootstrap-admin.js
