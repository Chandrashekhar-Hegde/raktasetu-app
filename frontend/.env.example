# Leave empty for same-origin /api (Railway unified + Vite proxy)
# VITE_API_URL=http://localhost:3001

# Public site origin for OG/canonical/JSON-LD/sitemap (no trailing slash).
# Default at build: https://raktasetu-production.up.railway.app
# At domain cutover set to https://raktasetu.in (see docs/ops/domain-cutover.md)
# VITE_SITE_ORIGIN=https://raktasetu-production.up.railway.app

# Google Identity Services client ID (must match backend GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com


# Public contact inboxes shown in the privacy policy, terms and help screens.
# Defaults are @raktasetu.org, which currently has NO mail server: set real, monitored inboxes before launch.
# VITE_PRIVACY_EMAIL=
# VITE_SUPPORT_EMAIL=
# VITE_SECURITY_EMAIL=

# --- Playwright (npm run test:e2e:full sets these for the local test DB) ---
# E2E_FULL=1
# E2E_BASE_URL=            # only when servers are already running
# E2E_HOSPITAL_EMAIL=hospital@test.invalid
# E2E_DONOR_EMAIL=donor@test.invalid
# E2E_FIXTURE_PASSWORD=
# Staging role-boundary check (public-and-access.spec.js):
# E2E_DONOR_IDENTIFIER=
# E2E_DONOR_PASSWORD=
